# Copy this file to .env and fill in your Supabase project values.
# Never commit the real .env file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Product analytics + error monitoring (client). Public, write-only client
# tokens — safe to expose in the built bundle.
VITE_POSTHOG_KEY=phc_your-posthog-project-token
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=https://your-sentry-dsn

# Server-side only — set as a Supabase Edge Function secret, NOT in
# this .env file and NOT exposed to the client. Lesson generation
# prompts and content libraries must stay server-side per the build
# spec's strategic constraints.
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# (SUPABASE_URL and SUPABASE_ANON_KEY are auto-provided to Edge
# Functions at runtime — no need to set them manually.)
