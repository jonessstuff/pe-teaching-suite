# Copy this file to .env and fill in your Supabase project values.
# Never commit the real .env file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — set as a Supabase Edge Function secret, NOT in
# this .env file and NOT exposed to the client. Lesson generation
# prompts and content libraries must stay server-side per the build
# spec's strategic constraints.
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# (SUPABASE_URL and SUPABASE_ANON_KEY are auto-provided to Edge
# Functions at runtime — no need to set them manually.)
